# Managed by the mastodon charm. Manual changes will be overwritten.
# Based on Mastodon's dist/nginx.conf.

map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      close;
}

{% if behind_proxy %}
# Trust the X-Forwarded-Proto sent by the upstream proxy; fall back to the
# actual scheme when the header is absent (direct access).
map $http_x_forwarded_proto $mastodon_fwd_proto {
  default $http_x_forwarded_proto;
  ''      $scheme;
}
{% endif %}

{% if has_web %}
upstream mastodon-backend {
  server 127.0.0.1:3000 fail_timeout=0;
}
{% endif %}

{% if has_streaming %}
upstream mastodon-streaming {
  least_conn;
  server 127.0.0.1:4000 fail_timeout=0;
}
{% endif %}

proxy_cache_path /var/cache/nginx levels=1:2 keys_zone=MASTODON_CACHE:10m inactive=7d max_size=1g;

{% if not behind_proxy %}
server {
  listen 80;
  listen [::]:80;
  server_name {{ hostname }};
  root {{ app_dir }}/public;
  location /.well-known/acme-challenge/ { allow all; }
  location / { return 301 https://$host$request_uri; }
}
{% endif %}

server {
{% if behind_proxy %}
  listen 80 default_server;
  listen [::]:80 default_server;
{% else %}
  # "listen ... http2" is deprecated in nginx >= 1.25 but required by the
  # nginx 1.24 shipped in Ubuntu 24.04 (no standalone "http2 on" directive).
  listen 443 ssl http2 default_server;
  listen [::]:443 ssl http2 default_server;

  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384:DHE-RSA-CHACHA20-POLY1305;
  ssl_prefer_server_ciphers on;
  ssl_session_cache shared:SSL:10m;
  ssl_session_tickets off;
  ssl_certificate     {{ tls_cert_path }};
  ssl_certificate_key {{ tls_key_path }};
{% endif %}
  server_name {{ hostname }};

  keepalive_timeout    70;
  sendfile             on;
  client_max_body_size 99m;

  root {{ app_dir }}/public;

  gzip on;
  gzip_disable "msie6";
  gzip_vary on;
  gzip_proxied any;
  gzip_comp_level 6;
  gzip_buffers 16 8k;
  gzip_http_version 1.1;
  gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/rss+xml text/javascript image/svg+xml image/x-icon;
  gzip_static on;

{% if has_web %}
  location / {
    try_files $uri @proxy;
  }

  location = /sw.js {
    add_header Cache-Control "public, max-age=604800, must-revalidate";
    try_files $uri =404;
  }

  location ~ ^/(assets|avatars|emoji|headers|packs|shortcuts|sounds)/ {
    add_header Cache-Control "public, max-age=2419200, must-revalidate";
    try_files $uri =404;
  }

  location ~ ^/system/ {
    add_header Cache-Control "public, max-age=2419200, immutable";
    add_header X-Content-Type-Options nosniff;
    add_header Content-Security-Policy "default-src 'none'; form-action 'none'";
    try_files $uri =404;
  }

  location @proxy {
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto {{ '$mastodon_fwd_proto' if behind_proxy else '$scheme' }};
    proxy_set_header Proxy "";
    proxy_pass_header Server;

    proxy_pass http://mastodon-backend;
    proxy_buffering on;
    proxy_redirect off;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;

    proxy_cache MASTODON_CACHE;
    proxy_cache_valid 200 7d;
    proxy_cache_valid 410 24h;
    proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
    add_header X-Cached $upstream_cache_status;

    tcp_nodelay on;
  }
{% else %}
  location / {
    return 404;
  }
{% endif %}

{% if has_streaming %}
  location /api/v1/streaming {
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto {{ '$mastodon_fwd_proto' if behind_proxy else '$scheme' }};
    proxy_set_header Proxy "";

    proxy_pass http://mastodon-streaming;
    proxy_buffering off;
    proxy_redirect off;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;

    tcp_nodelay on;
  }
{% endif %}

  error_page 404 500 501 502 503 504 /500.html;
}
